{
  "name": "openscope",
  "version": "6.29.0-BETA",
  "description": "An ATC simulator in HTML5",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:assets && vite build",
    "build:assets": "node scripts/build-assets.js",
    "preview": "vite preview",
    "build:gulp": "gulp build --prod",
    "build:dev:gulp": "gulp build",
    "gulp": "gulp build",
    "lint-diff": "eslint src/assets/scripts/client/**",
    "lint": "eslint src/assets/scripts/client/**",
    "posttest": "npm run report",
    "report": "nyc report --reporter=cobertura --reporter=lcov",
    "server": "npm run start",
    "start": "node public/assets/scripts/server/index.js",
    "test": "nyc ava --concurrency=5",
    "validator": "validator -a"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openscope/openscope.git"
  },
  "keywords": [
    "atc",
    "html5",
    "canvas",
    "javascript",
    "game",
    "simulator",
    "air traffic control",
    "airline",
    "aviation",
    "airplane"
  ],
  "author": "Jon Ross <jonrosszlsa@gmail.com> (http://zlsa.github.io/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/openscope/openscope/issues"
  },
  "homepage": "https://github.com/openscope/openscope",
  "ava": {
    "files": [
      "test/**/*.spec.js"
    ],
    "sources": [
      "!**/_mocks/**",
      "!**/fixtures/**",
      "!**/testHelpers/**"
    ],
    "verbose": true,
    "require": [
      "@babel/register",
      "./test/testHelpers/globalProps.js",
      "./test/testHelpers/localStorage.js",
      "./test/testHelpers/setupBrowserEnv.js"
    ]
  },
  "nyc": {
    "all": false,
    "include": [
      "src/assets/scripts/**/*.js",
      "!src/assets/scripts/client/constants/**/*.js",
      "!**/_mocks/**",
      "!**/fixtures/**",
      "!**/testHelpers/**",
      "!**/public/**"
    ]
  },
  "dependencies": {
    "ansi-colors": "3.2.4",
    "express": "4.21.2",
    "handlebars": "4.7.8",
    "jquery": "3.5.0",
    "lodash": "4.17.21",
    "raf": "3.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.22.0",
    "@babel/plugin-proposal-class-properties": "^7.18.0",
    "@babel/plugin-proposal-json-strings": "^7.18.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.0",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.0",
    "@babel/plugin-syntax-import-meta": "^7.10.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/register": "^7.22.0",
    "@openscope/validator": "latest",
    "@vitejs/plugin-legacy": "7.2.1",
    "ava": "^6.4.1",
    "babelify": "^10.0.0",
    "browser-env": "^3.3.0",
    "browserify": "^17.0.0",
    "core-js": "^3.33.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.0",
    "fancy-log": "^2.0.0",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^9.0.0",
    "gulp-clean": "^0.4.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-cli": "^3.1.0",
    "gulp-concat": "^2.6.1",
    "gulp-eslint": "^6.0.0",
    "gulp-hb": "^8.0.0",
    "gulp-if": "^3.0.0",
    "gulp-jsonmin": "^1.2.0",
    "gulp-less": "^5.0.0",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "handlebars-helpers": "0.10.0",
    "handlebars-layouts": "3.1.4",
    "less": "4.4.0",
    "marked": "^16.1.1",
    "merge-stream": "^2.0.0",
    "mkdirp": "^3.0.1",
    "nyc": "^17.1.0",
    "path": "0.12.7",
    "regenerator-runtime": "^0.14.0",
    "rimraf": "2.6.3",
    "showdown": "1.9.1",
    "sinon": "7.3.2",
    "vinyl-buffer": "^1.0.1",
    "vinyl-source-stream": "^2.0.0",
    "vite": "7.1.2",
    "vite-plugin-eslint": "1.8.1",
    "vite-plugin-handlebars": "2.0.0",
    "yargs": "13.2.2"
  }
}
